# Canonical origin. Consumed by metadataBase, buildMetadata, the sitemap, structured
# data, and the contact endpoint's CORS allowlist (spec §13). No www, no trailing slash.
#
# Production only. Preview deployments leave this unset on purpose so app/layout.tsx
# falls back to https://$VERCEL_URL and previews never emit production canonicals.
NEXT_PUBLIC_SITE_URL=https://mukeremshifa.com

# Crawl policy (spec §13.3). Unset means blocked: app/robots.ts disallows everything and
# app/layout.tsx emits `noindex, nofollow`. That is what makes promoting dev to production
# at every phase boundary safe while the site is still full of placeholder copy.
# The Phase 6 hardening pass sets this to true in the Production environment, and only
# then. Do not set it locally unless you are testing that path.
# ALLOW_INDEXING=true

# Contact endpoint delivery (spec §14). The endpoint itself is a Next route handler at
# app/api/contact/route.ts, same-origin, so there is no CORS allowlist and no separate
# host — see the 2026-09-01 entry in docs/DECISIONS.md for why the Cloudflare Worker was
# dropped. These three are server-side only: no NEXT_PUBLIC_ prefix, never in the bundle.
#
# Unset in local development. The form still renders and validates; submitting returns a
# 502 and the failure path shows the direct mailto:, which is the intended degraded path.
# RESEND_API_KEY=re_xxxxxxxx
# CONTACT_TO_EMAIL=hello@mukeremshifa.com
# CONTACT_FROM_EMAIL=noreply@mukeremshifa.com
